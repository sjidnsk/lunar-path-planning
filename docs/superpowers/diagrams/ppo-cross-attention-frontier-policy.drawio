        <mxCell id="17" value="Frontier-to-Context Cross-Attention Blocks x2&#xa;Q = frontier_tokens, K,V = context_tokens&#xa;Residual + LayerNorm + FFN&#xa;复杂度 O(M*K)，避免候选 self-attention 的 O(M²)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=12;" vertex="1" parent="1">
