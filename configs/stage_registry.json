{
  "schema_version": "lunar-stage-registry/v1",
  "stages": {
    "xunce-shadow-replay-validation": {
      "script": "scripts/run_xunce_shadow_replay_validation.py",
      "default_config": "configs/xunce_shadow_replay_validation_v1.json",
      "default_output_root": "outputs/path_feedback_batch_xunce_shadow_replay_validation_v1",
      "args": ["--config", "{config}", "--output-root", "{output_root}"]
    },
    "xunce-sandbox-candidate-preflight": {
      "script": "scripts/run_xunce_sandbox_candidate_preflight.py",
      "default_config": "configs/xunce_sandbox_candidate_preflight_v1.json",
      "default_output_root": "outputs/path_feedback_batch_xunce_sandbox_candidate_preflight_v1",
      "args": ["--config", "{config}", "--output-root", "{output_root}"]
    },
    "xunce-release-governance-gate": {
      "script": "scripts/run_xunce_release_governance_gate.py",
      "default_config": "configs/xunce_release_governance_gate_v1.json",
      "default_output_root": "outputs/path_feedback_batch_xunce_release_governance_gate_v1",
      "args": ["--config", "{config}", "--output-root", "{output_root}"]
    },
    "xunce-high-fidelity-real-map-roi-expansion": {
      "script": "scripts/run_xunce_high_fidelity_real_map_roi_expansion.py",
      "default_config": "configs/xunce_high_fidelity_real_map_roi_expansion_v1.json",
      "default_output_root": "outputs/path_feedback_batch_xunce_high_fidelity_real_map_roi_expansion_v1",
      "args": ["--config", "{config}", "--output-root", "{output_root}", "--repo-root", "{repo_root}"]
    },
    "xunce-high-fidelity-real-map-comparison": {
      "script": "scripts/run_xunce_high_fidelity_real_map_comparison.py",
      "default_config": "configs/xunce_high_fidelity_real_map_comparison_v1.json",
      "default_output_root": "outputs/path_feedback_batch_xunce_high_fidelity_real_map_comparison_v1",
      "args": ["--config", "{config}", "--output-root", "{output_root}", "--repo-root", "{repo_root}"]
    },
    "path-feedback-validation": {
      "script": "scripts/run_path_feedback_validation.py",
      "default_output_root": "outputs/path_feedback_validation",
      "args": ["--output-root", "{output_root}"]
    },
    "path-feedback-batch-validation": {
      "script": "scripts/run_batch_path_feedback_validation.py",
      "default_config": "configs/path_feedback_batch_dataset_v1.json",
      "default_output_root": "outputs/path_feedback_batch_smoke",
      "args": ["--matrix", "{config}", "--output-root", "{output_root}"]
    },
    "policy-training-readiness-review": {
      "script": "scripts/run_policy_training_readiness_review.py",
      "default_config": "configs/policy_training_readiness_review_v1.json",
      "default_output_root": "outputs/path_feedback_batch_training_readiness_review_v1",
      "args": ["--batch-root", "{output_root}", "--config", "{config}", "--dry-run"]
    },
    "policy-gated-sequential-canary-rollout": {
      "script": "scripts/run_policy_gated_sequential_canary_rollout.py",
      "default_config": "configs/policy_gated_sequential_canary_rollout_v1.json",
      "default_output_root": "outputs/path_feedback_batch_policy_gated_sequential_canary_rollout_v1",
      "args": [
        "--source-root", "outputs/path_feedback_batch_value_stability_clean_src_v1",
        "--candidate-root", "outputs/path_feedback_batch_value_stability_candidate_v1",
        "--batch-root", "{output_root}",
        "--config", "{config}"
      ]
    },
    "guarded-ppo-rollout-pilot": {
      "script": "scripts/run_guarded_ppo_rollout_pilot.py",
      "default_config": "configs/guarded_ppo_rollout_pilot_v1.json",
      "default_output_root": "outputs/path_feedback_batch_guarded_ppo_rollout_pilot_v1",
      "args": [
        "--source-root", "outputs/path_feedback_batch_guarded_ppo_rollout_clean_src_v1",
        "--base-candidate-root", "outputs/path_feedback_batch_quasi_real_guarded_ppo_iterative_miniloop_stability_v1",
        "--raw-baseline-candidate-root", "outputs/path_feedback_batch_value_stability_candidate_v1",
        "--dev-root", "outputs/path_feedback_batch_raw_policy_generalization_dev_v1",
        "--val-root", "outputs/path_feedback_batch_raw_policy_generalization_val_v1",
        "--test-root", "outputs/path_feedback_batch_raw_policy_generalization_test_v1",
        "--quasi-real-root", "outputs/path_feedback_batch_quasi_real_safe_better_opportunity_expansion_v1",
        "--output-root", "{output_root}",
        "--config", "{config}"
      ]
    },
    "iterative-ppo-mini-loop-stability": {
      "script": "scripts/run_iterative_ppo_mini_loop_stability.py",
      "default_config": "configs/iterative_ppo_mini_loop_stability_v1.json",
      "default_output_root": "outputs/path_feedback_batch_iterative_ppo_mini_loop_stability_v1",
      "args": [
        "--source-root", "outputs/path_feedback_batch_sequential_multi_step_opportunity_dev_v1",
        "--initial-candidate-root", "outputs/path_feedback_batch_limited_ppo_update_smoke_v1",
        "--raw-baseline-candidate-root", "outputs/path_feedback_batch_value_stability_candidate_v1",
        "--dev-root", "outputs/path_feedback_batch_raw_policy_generalization_dev_v1",
        "--val-root", "outputs/path_feedback_batch_raw_policy_generalization_val_v1",
        "--test-root", "outputs/path_feedback_batch_raw_policy_generalization_test_v1",
        "--output-root", "{output_root}",
        "--config", "{config}"
      ]
    },
    "quasi-real-guarded-ppo-stability-replay": {
      "script": "scripts/run_quasi_real_guarded_ppo_stability_replay.py",
      "default_config": "configs/quasi_real_guarded_ppo_stability_replay_v1.json",
      "default_output_root": "outputs/path_feedback_batch_quasi_real_guarded_ppo_stability_replay_v1",
      "args": [
        "--freeze-root", "outputs/path_feedback_batch_quasi_real_guarded_ppo_evidence_freeze_v1",
        "--batch-root", "outputs/path_feedback_batch_guarded_ppo_rollout_clean_src_v1",
        "--output-root", "{output_root}",
        "--config", "{config}"
      ]
    }
  }
}
