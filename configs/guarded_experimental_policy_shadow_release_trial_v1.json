{
  "schema_version": "guarded-experimental-policy-shadow-release-trial-config/v1",
  "description": "Run a guarded shadow release trial for the packaged experimental policy. The default policy remains authoritative; the experimental policy only records shadow decisions and diagnostic gate accounting.",
  "default_paths": {
    "install_canary_root": "outputs/path_feedback_batch_guarded_experimental_policy_install_canary_dry_run_v1",
    "multihorizon_shadow_root": "outputs/path_feedback_batch_selected_formal_ppo_candidate_multihorizon_shadow_rollout_v1",
    "batch_root": "outputs/path_feedback_batch_guarded_ppo_rollout_clean_src_v1",
    "output_root": "outputs/path_feedback_batch_guarded_experimental_policy_shadow_release_trial_v1"
  },
  "input_files": {
    "install_canary_summary": "guarded-experimental-policy-install-canary-dry-run-summary.json",
    "multihorizon_shadow_summary": "multihorizon-shadow-rollout-summary.json",
    "multihorizon_shadow_steps": "multihorizon-shadow-rollout-steps.jsonl"
  },
  "validation": {
    "min_install_canary_step_count": 64,
    "min_shadow_step_count": 256,
    "min_unique_shadow_context_count": 256
  },
  "default_policy": {
    "path": ""
  },
  "readiness": {
    "config": "configs/policy_training_readiness_review_v1.json",
    "expected_status": "guarded_experimental_policy_shadow_release_trial_evaluated"
  },
  "output_files": {
    "summary": "guarded-experimental-policy-shadow-release-trial-summary.json",
    "runtime_manifest": "shadow-release-runtime-manifest.json",
    "step_comparison": "shadow-release-step-comparison.jsonl",
    "rejection_report": "shadow-release-rejection-report.json",
    "risk_reward_audit": "shadow-release-risk-reward-audit.json",
    "readiness_validate_only": "shadow-release-readiness-validate-only.json",
    "report": "shadow-release-report.md"
  },
  "documentation_updates": [
    "README.md",
    "docs/算法设计与系统架构报告.md",
    "docs/superpowers/specs/2026-06-14-guarded-experimental-policy-shadow-release-trial.md"
  ],
  "non_goals": [
    "does_not_run_new_ppo_update",
    "does_not_publish_checkpoint",
    "does_not_replace_default_policy",
    "does_not_modify_network",
    "does_not_modify_action_space",
    "does_not_modify_default_astar",
    "does_not_relax_distance_path_risk_or_source_selection_gates",
    "does_not_download_new_raw_data",
    "does_not_claim_ackermann_feasible_trajectory",
    "does_not_treat_iris_gcs_or_path_planner_diagnostics_as_training_release",
    "does_not_claim_policy_performance",
    "does_not_claim_formal_training_ready"
  ]
}
