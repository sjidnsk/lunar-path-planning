    "tests/test_xunce_stage1[89]_*.py",
    "tests/test_xunce_stage2[0-6]_*.py",
    "scripts/*stage1[89]*.py",
    "scripts/*stage2[0-6]*.py",
    "configs/*stage1[89]*.json",
